{
  "name": "skillpin",
  "version": "0.1.0",
  "private": true,
  "description": "Local skill source manager",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@skillpin/web",
    "build": "npm run build --workspace=@skillpin/core && npm run build --workspace=@skillpin/cli && npm run build --workspace=@skillpin/web",
    "typecheck": "npm run build --workspace=@skillpin/core && npm run typecheck --workspace=@skillpin/cli && npm run typecheck --workspace=@skillpin/web",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack": "npm run build && node scripts/build-package.mjs",
    "verify-package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
